<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <!-- Favicons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000003" />
    <ResourcePreloader />
    <ImportMap />

    <!-- Set initial theme early (defaults to system if no user choice) -->
    <script>!(function(){try{const k='vkine-theme',s=localStorage.getItem(k);const prefers=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;const applied=(s==='system'||!s)?(prefers?'dark':'light'):s;document.documentElement.setAttribute('data-theme',applied);document.documentElement.dataset.vkineThemeMode=s||'system';const tc=document.querySelector('meta[name="theme-color"]');if(tc)tc.setAttribute('content',applied==='dark'?'#0B0B0D':'#F2F2F7');}catch(e){/*ignore*/}})()</script>

    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="css/flatpickr-apple.css" />
    <link rel="stylesheet" href="@Assets["vkine.styles.css"]" />
    <HeadOutlet />
</head>
<body>
    <Routes />

    <div id="components-reconnect-modal">
        <div class="reconnect-backdrop"></div>
        <div class="reconnect-card">
            <div class="reconnect-state reconnect-state--connecting">
                <div class="reconnect-spinner"></div>
                <p class="reconnect-title">Reconnecting&hellip;</p>
                <p class="reconnect-message">Restoring your connection.</p>
            </div>
            <div class="reconnect-state reconnect-state--failed">
                <div class="reconnect-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 1l22 22M16.72 11.06A10.94 10.94 0 0 1 19 12.55M5 12.55a10.94 10.94 0 0 1 5.17-2.39M10.71 5.05A16 16 0 0 1 22.56 9M1.42 9a15.91 15.91 0 0 1 4.7-2.88M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/>
                    </svg>
                </div>
                <p class="reconnect-title">Connection Lost</p>
                <p class="reconnect-message">Check your internet connection and try again.</p>
                <button class="reconnect-btn" onclick="window.Blazor.reconnect()">Try Again</button>
            </div>
            <div class="reconnect-state reconnect-state--rejected">
                <div class="reconnect-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                </div>
                <p class="reconnect-title">Session Ended</p>
                <p class="reconnect-message">Your session has expired. Reload to continue.</p>
                <button class="reconnect-btn" onclick="location.reload()">Reload Page</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/cs.js"></script>
    <script src="/js/theme.js"></script>
    <script src="/js/locale.js"></script>
    <script src="/js/movieModal.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
